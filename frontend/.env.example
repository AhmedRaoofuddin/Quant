# Backend REST API (C++ `alphaforge serve`). Used for discovery + as data fallback.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: read runs directly from local Supabase instead of the C++ API.
# Find these values in the output of `supabase start`.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
