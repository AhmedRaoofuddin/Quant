{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ninja:*)",
      "Bash(ctest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(supabase:*)"
    ],
    "deny": []
  },
  "env": {
    "AF_ENVIRONMENT": "development",
    "AF_LLM_OFFLINE": "true"
  }
}
